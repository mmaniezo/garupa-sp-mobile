# Copie para .env.local (não vai para o Git) e ajuste.

# mock = API simulada com o mesmo contrato e os mesmos dados do modelo (padrão, funciona sem servidor)
# http = API C# de verdade (github.com/caio-alex/garupa-sp-api), no endereço abaixo
EXPO_PUBLIC_API_MODE=mock

# Endereço da API sem o /api/v1. Produção (é a do APK publicado):
#   https://garupa-sp-api-production.up.railway.app
# A API não libera CORS: no navegador (prévia web), use o mock; no celular, a produção funciona.
# Para uma API local no celular, use o IP do computador na rede (não localhost), com a API
# ouvindo em todas as interfaces: dotnet run --project 'Garupa API' --urls http://0.0.0.0:5221
EXPO_PUBLIC_API_URL=

# Atalhos de demonstração (simular queda, pulseira sem o Wokwi). Ligados por padrão; 0 desliga.
# EXPO_PUBLIC_DEMO=0

# Chave do Google Maps (Maps SDK for Android), só para o build de desenvolvimento ou o APK.
# No Expo Go não precisa. Sem ela, o build mostra o mapa esquemático no lugar do Google Maps.
GOOGLE_MAPS_API_KEY=
