# Copie para .env.local (não vai para o Git) e ajuste.

# mock = API simulada com o mesmo contrato e os mesmos dados do modelo (padrão, funciona sem servidor)
# http = API C# de verdade (github.com/caio-alex/garupa-sp-api), no endereço abaixo
EXPO_PUBLIC_API_MODE=mock

# Endereço da API sem o /api/v1. No celular, use o IP do computador na rede (não localhost),
# com a API ouvindo em todas as interfaces: dotnet run --project 'Garupa API' --urls http://0.0.0.0:5221
# Ex.: http://192.168.0.10:5221
EXPO_PUBLIC_API_URL=
